class Solution {

    public static int findEquilibrium(int arr[]) {

        int totalSum = 0;

        // Calculate total sum
        for(int num : arr) {
            totalSum += num;
        }

        int leftSum = 0;

        for(int i = 0; i < arr.length; i++) {

            // Remove current element from totalSum
            totalSum -= arr[i];

            // Check equilibrium
            if(leftSum == totalSum) {
                return i;
            }

            // Add current element to leftSum
            leftSum += arr[i];
        }

        return -1;
    }
}
